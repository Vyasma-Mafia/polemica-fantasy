      "multiSourceChart": {
        "id": "pffinal",
        "title": "Finalization effects (24h)",
        "displayLegend": true,
        "targets": [
          {
            "prometheusTarget": {
              "dataSourceId": "msp",
              "workspaceId": "mon9v9q5apml8dnnchl7",
              "query": "increase(fantasy_series_finalizations_total{job=\"polemica-fantasy-backend\"}[24h])",
              "textMode": true,
              "name": "finalizations"
            }
          },
          {
            "prometheusTarget": {
              "dataSourceId": "msp",
              "workspaceId": "mon9v9q5apml8dnnchl7",
              "query": "increase(fantasy_series_finalization_rewarded_users_total{job=\"polemica-fantasy-backend\"}[24h])",
              "textMode": true,
              "name": "rewarded_users"
            }
          },
          {
            "prometheusTarget": {
              "dataSourceId": "msp",
              "workspaceId": "mon9v9q5apml8dnnchl7",
              "query": "increase(fantasy_series_finalization_card_uses_decremented_total{job=\"polemica-fantasy-backend\"}[24h])",
              "textMode": true,
              "name": "card_uses_decremented"
            }
          }
        ],
        "dataSources": [{"prometheusDataSource": {"id": "msp", "step": "60000"}}],
        "visualizationSettings": {
          "type": "VISUALIZATION_TYPE_COLUMN",
          "interpolate": "INTERPOLATE_LEFT",
          "colorSchemeSettings": {"automatic": {}}
