            "query": "sum by (result) (increase(fantasy_scoring_duration_seconds_count{job=\"polemica-fantasy-backend\"}[1h]))",
            "textMode": true,
            "name": "scoring"
          }
        }],
        "dataSources": [{"prometheusDataSource": {"id": "msp", "step": "60000"}}],
        "visualizationSettings": {
          "type": "VISUALIZATION_TYPE_COLUMN",
          "interpolate": "INTERPOLATE_LEFT",
          "colorSchemeSettings": {"automatic": {}}
        }
      }
    },
    {
      "position": {"x": "0", "y": "24", "w": "18", "h": "8"},
      "multiSourceChart": {
        "id": "pfnotify",
        "title": "Notification outcomes (1h)",
        "displayLegend": true,
        "targets": [{
          "prometheusTarget": {
            "dataSourceId": "msp",
            "workspaceId": "mon9v9q5apml8dnnchl7",
