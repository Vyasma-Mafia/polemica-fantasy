# Database (matches docker-compose defaults when unset)
DB_USER=fantasy
DB_PASSWORD=fantasy
# Host port mapping if 5433 is already in use: POSTGRES_HOST_PORT=5434 docker compose up -d

# Spring datasource (optional override for local non-Docker runs)
# DATABASE_URL=jdbc:postgresql://localhost:5433/fantasy
# DATABASE_USER=fantasy
# DATABASE_PASSWORD=fantasy

# S3 — MinIO locally (docker-compose.yml defaults); production: Yandex Object Storage (see ~/personal/mafia/overlay/.env.example: same endpoint/region)
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=polemica-fantasy-images
# Optional: disable auto-create bucket (set false for Yandex when bucket already exists)
# S3_ENSURE_BUCKET=true

# Production (docker-compose.prod.yml) typical Yandex values:
# S3_ENDPOINT=https://storage.yandexcloud.net
# S3_REGION=ru-central1
# S3_BUCKET=polemica-fantasy
# S3_ENSURE_BUCKET=false

# Telegram (Mini App initData validation; same token for Bot API notifications after series finalization)
TELEGRAM_BOT_TOKEN=
# Optional: disable Telegram notifications without removing the token (default true)
# TELEGRAM_NOTIFICATIONS_ENABLED=false

# Polemica API (required for POST .../sync-games)
POLEMICA_USERNAME=
POLEMICA_PASSWORD=
# Optional; default https://polemicagame.com
# POLEMICA_PROFILE_SITE_BASE_URL=https://polemicagame.com

# Admin API (Basic Auth — see application.yml app.admin.username / app.admin.password)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
