[Unit]
Description=Polemica AI Research MCP
Requires=polemica-agent-migrate.service
After=network-online.target polemica-agent-migrate.service
Wants=network-online.target

[Service]
Type=simple
User=polemica-agent-broker
Group=polemica-agent-broker
EnvironmentFile=/etc/polemica-ai-agent/research-mcp.env
Environment=MCP_BIND_HOST=127.0.0.1 MCP_BIND_PORT=8812 POLEMICA_AGENT_DATABASE=/var/lib/polemica-ai-agent/agent.sqlite3 POLEMICA_RESEARCH_CACHE=/var/lib/polemica-ai-agent/research-cache
ExecStart=/opt/polemica-ai-agent/venv/bin/polemica-agent-mcp research
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/polemica-ai-agent
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0077
InaccessiblePaths=-/root/.ssh -/home/codex/.ssh -/proc/kcore -/proc/keys -/proc/timer_list

[Install]
WantedBy=multi-user.target
